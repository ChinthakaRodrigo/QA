{
  "name": "library-backend",
  "version": "1.0.0",
  "description": "Library Management System - REST API (Node.js, Express, SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:blackbox": "jest tests/blackbox",
    "test:whitebox": "jest tests/whitebox --coverage",
    "test:whitebox:statement": "jest tests/whitebox -t STMT --coverage",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
